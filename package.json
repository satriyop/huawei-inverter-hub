{
  "name": "huawei-inverter-crawler",
  "version": "1.0.0",
  "description": "FusionSolar crawler for NexSolarHub",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "crawl": "tsx src/index.ts",
    "crawl:once": "tsx src/crawl-once.ts",
    "crawl:push": "tsx src/crawl-once.ts --push",
    "push:laravel": "tsx src/push-to-laravel.ts",
    "test:login": "tsx src/test-login.ts",
    "lint": "eslint src/**/*.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "fusionsolar",
    "huawei",
    "inverter",
    "solar",
    "crawler"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.0",
    "dotenv": "^16.3.0",
    "puppeteer": "^21.6.0",
    "winston": "^3.11.0",
    "cron": "^3.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "tsx": "^4.6.0",
    "typescript": "^5.3.0",
    "@types/cron": "^2.4.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
