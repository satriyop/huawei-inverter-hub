# FusionSolar Credentials
FUSIONSOLAR_BASE_URL=https://sg5.fusionsolar.huawei.com
FUSIONSOLAR_LOGIN_URL=https://sg5.fusionsolar.huawei.com/pvmswebsite/login/build/index.html
FUSIONSOLAR_USERNAME=your_username
FUSIONSOLAR_PASSWORD=your_password
FUSIONSOLAR_TIMEZONE=7
FUSIONSOLAR_TIMEZONE_STR=Asia/Jakarta

# Crawler Settings
CRAWLER_INTERVAL_MINUTES=5
CRAWLER_RETRY_ATTEMPTS=3
CRAWLER_RETRY_DELAY_MS=30000
CRAWLER_REQUEST_DELAY_MS=1000
CRAWLER_HEADLESS=true

# NexSolarHub API (Laravel backend)
NEXSOLARHUB_API_URL=http://localhost:8000/api/v1
NEXSOLARHUB_API_KEY=your_api_key_here

# Logging
LOG_LEVEL=info
LOG_FILE=logs/crawler.log
